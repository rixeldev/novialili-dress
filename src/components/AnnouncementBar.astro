---
import Icon from './Icon.astro'
import { ui } from '../i18n'

const { t } = ui(Astro.currentLocale)
const items = t('announcement', { returnObjects: true }) as string[]
---

<div class="bg-rose-800 text-ivory-50 hidden sm:flex" role="region" aria-label="Novialili Dress">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-5 gap-y-1 px-6 py-2 text-[0.68rem] font-medium tracking-[0.24em] uppercase">
    {
      items.map((item, i) => (
        <span class="flex items-center gap-x-5">
          {i > 0 && (
            <span class="h-1 w-1 rounded-full bg-rose-300/80" aria-hidden="true"></span>
          )}
          <span>{item}</span>
        </span>
      ))
    }
  </div>
</div>