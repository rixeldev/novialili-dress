---
import Icon from './Icon.astro'
import { ui } from '../i18n'
import { SITE } from '../lib/site'

const { t } = ui(Astro.currentLocale)
---

<section id="contacto" class="bg-ivory-100 py-24 sm:py-32" aria-labelledby="cta-title">
  <div class="mx-auto max-w-7xl px-6">
    <div
      class="relative overflow-hidden rounded-[2.5rem] bg-rose-100 px-8 py-16 sm:px-16 sm:py-20"
      data-reveal
    >
      <img
        src="/images/tiara.png"
        alt=""
        width="640"
        height="360"
        class="pointer-events-none absolute -right-8 -top-10 w-44 rotate-12 opacity-30"
      />

      <div class="relative mx-auto max-w-2xl text-center">
        <p class="eyebrow flex items-center justify-center gap-3 text-rose-700">
          <span class="h-px w-10 bg-rose-300" aria-hidden="true"></span>
          {t('hero.eyebrow')}
          <span class="h-px w-10 bg-rose-300" aria-hidden="true"></span>
        </p>
        <h2 id="cta-title" class="mt-6 font-serif text-4xl leading-tight text-ink-900 sm:text-5xl">
          {t('cta.titleStart')} <em class="italic text-rose-700">{t('cta.titleItalic')}</em>
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-700/90">{t('cta.text')}</p>

        <div class="mt-11 flex flex-wrap items-center justify-center gap-4">
          <a
            href={SITE.phoneHref}
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-rose-800 px-8 py-4 text-xs font-semibold tracking-[0.18em] uppercase text-ivory-50 shadow-lg shadow-rose-800/25 transition-all duration-300 hover:-translate-y-0.5 hover:bg-rose-900"
          >
            <Icon name="phone" size={15} />
            {t('cta.primary')}
          </a>
          <a
            href={SITE.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 rounded-full border border-rose-800 px-8 py-4 text-xs font-semibold tracking-[0.18em] uppercase text-rose-800 transition-all duration-300 hover:-translate-y-0.5 hover:bg-rose-800 hover:text-ivory-50"
          >
            <Icon name="whatsapp" size={16} />
            {t('cta.secondary')}
          </a>
        </div>

        <p class="mt-10 flex flex-wrap items-center justify-center gap-2 text-[0.72rem] font-medium tracking-[0.14em] uppercase text-ink-500">
          <Icon name="clock" size={14} class="text-rose-700" />
          {t('cta.note')}
        </p>
      </div>
    </div>
  </div>
</section>