---
import Icon from './Icon.astro'
import { ui } from '../i18n'
import { SITE } from '../lib/site'

const { t } = ui(Astro.currentLocale)
const items = t('testimonials.items', { returnObjects: true }) as { text: string; author: string }[]
---

<section id="testimonios" class="bg-ink-900 py-24 text-ivory-100 sm:py-32" aria-labelledby="testimonials-title">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow flex items-center justify-center gap-3 text-rose-300">
        <span class="h-px w-10 bg-rose-400/60" aria-hidden="true"></span>
        {t('testimonials.eyebrow')}
        <span class="h-px w-10 bg-rose-400/60" aria-hidden="true"></span>
      </p>
      <h2 id="testimonials-title" class="mt-5 font-serif text-4xl leading-tight text-ivory-50 sm:text-5xl">
        {t('testimonials.title')}
      </h2>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <span class="flex items-center gap-1.5" role="img" aria-label="5 de 5 estrellas">
          {[0, 1, 2, 3, 4].map(() => (
            <Icon name="star" size={15} class="text-rose-300" />
          ))}
        </span>
        <strong class="font-serif text-2xl italic text-ivory-50">{t('testimonials.rating')}</strong>
        <span class="text-sm text-ivory-100/70">{t('testimonials.ratingNote')}</span>
      </div>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        items.map((item, i) => (
          <figure class="border-t border-ivory-50/15 pt-8" data-reveal style={`transition-delay: ${(i + 1) * 110}ms`}>
            <span class="block font-serif text-6xl leading-none text-rose-300" aria-hidden="true">
              &#8220;
            </span>
            <blockquote class="mt-4 font-serif text-lg italic leading-relaxed text-ivory-100/90">
              {item.text}
            </blockquote>
            <figcaption class="mt-7 flex items-center gap-5">
              <span class="h-px w-8 bg-rose-400/60" aria-hidden="true"></span>
              <span class="text-xs font-semibold tracking-[0.22em] uppercase text-rose-200">
                {item.author}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-16 text-center" data-reveal>
      <a
        href={SITE.googleReviews}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 border-b border-rose-300 pb-1.5 text-xs font-semibold tracking-[0.2em] uppercase text-rose-300 transition-colors hover:border-rose-200 hover:text-rose-200"
      >
        {t('testimonials.reviewsCta')}
        <Icon name="arrowRight" size={15} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>