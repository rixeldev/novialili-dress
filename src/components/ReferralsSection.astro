---
import Icon from './Icon.astro'
import { ui } from '../i18n'
import { SITE } from '../lib/site'

const { t } = ui(Astro.currentLocale)
const steps = t('referrals.steps', { returnObjects: true }) as string[]
const ctaHref = `${SITE.whatsappHref}&text=${encodeURIComponent(t('referrals.msg'))}`
---

<section id="referidos" class="bg-ink-900 py-20 sm:py-24" aria-labelledby="referrals-title">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16" data-reveal>
      <div class="lg:col-span-5">
        <p class="eyebrow flex items-center gap-3 text-rose-300">
          <span class="h-px w-10 bg-rose-400/60" aria-hidden="true"></span>
          {t('referrals.eyebrow')}
        </p>
        <h2 id="referrals-title" class="mt-5 font-serif text-4xl leading-tight text-ivory-50 sm:text-5xl">
          {t('referrals.title')}
        </h2>
        <p class="mt-6 leading-relaxed text-ivory-200/90">{t('referrals.text')}</p>
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-9 inline-flex items-center justify-center gap-2.5 rounded-full bg-rose-700 px-8 py-4 text-xs font-semibold tracking-[0.18em] uppercase text-ivory-50 shadow-lg shadow-rose-900/40 transition-all duration-300 hover:-translate-y-0.5 hover:bg-rose-800"
        >
          <Icon name="gift" size={15} />
          {t('referrals.cta')}
        </a>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-[0.72rem] font-semibold tracking-[0.22em] uppercase text-ivory-200/50">
          {t('referrals.stepsTitle')}
        </p>
        <ol class="mt-6 space-y-5">
          {steps.map((step, i) => (
            <li class="flex items-start gap-5">
              <span
                class={`grid h-11 w-11 shrink-0 place-items-center rounded-full border font-serif text-lg ${
                  i === 1 ? 'border-rose-400 bg-rose-700 text-ivory-50' : 'border-ivory-500/40 text-ivory-100'
                }`}
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <p class="pt-2.5 leading-relaxed text-ivory-100">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>