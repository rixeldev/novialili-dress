---
import { ui } from '../i18n'
import 'lite-youtube-embed/src/lite-yt-embed.css'

const { t } = ui(Astro.currentLocale)
const themes = t('story.themes', { returnObjects: true }) as { title: string; text: string }[]
---

<section id="historia" class="bg-ivory-50 py-24 sm:py-32" aria-labelledby="story-title">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="relative flex flex-col lg:col-span-5" data-reveal>
        <div
          class="absolute -left-4 -top-4 hidden h-full w-full border border-rose-300 sm:block"
          aria-hidden="true"
        ></div>
        <div class="relative flex-1 overflow-hidden bg-ivory-200">
          <img
            src="/images/story.jpg"
            alt={t('story.imageAlt')}
            width="1066"
            height="1600"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-center"
          />
        </div>
        <p class="mt-5 text-[0.65rem] font-medium tracking-[0.28em] uppercase text-ink-500">
          {t('story.place')}
        </p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div data-reveal>
          <p class="eyebrow flex items-center gap-3 text-rose-700">
            <span class="h-px w-10 bg-rose-300" aria-hidden="true"></span>
            {t('story.eyebrow')}
          </p>
          <h2 id="story-title" class="mt-5 font-serif text-4xl leading-tight text-ink-900 sm:text-5xl">
            {t('story.title')}
          </h2>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-700/90">{t('story.intro')}</p>
        </div>

        <ol class="mt-12 space-y-10">
          {
            themes.map((theme, i) => (
              <li class="border-l-2 border-rose-300 pl-6 sm:pl-8" data-reveal style={`transition-delay: ${(i + 1) * 100}ms`}>
                <h3 class="font-serif text-2xl leading-snug text-ink-900">{theme.title}</h3>
                <p class="mt-3 max-w-lg leading-relaxed text-ink-700/90">{theme.text}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-14 border-t border-ink-900/10 pt-8" data-reveal>
          <p class="font-serif text-2xl italic leading-snug text-rose-700">{t('story.founder')}</p>
          <p class="mt-2 text-[0.65rem] font-semibold tracking-[0.28em] uppercase text-ink-500">
            {t('story.founderRole')}
          </p>
        </div>
      </div>

      <div
        class="mx-auto mt-20 w-full lg:col-span-12 lg:w-[min(80vw,72rem)]"
        data-reveal
      >
        <p class="eyebrow flex flex-wrap items-center justify-center gap-3 text-center text-rose-700">
          <span class="h-px w-10 bg-rose-300" aria-hidden="true"></span>
          {t('story.videoEyebrow')}
          <span class="h-px w-10 bg-rose-300" aria-hidden="true"></span>
        </p>
        <lite-youtube
          class="youtube-bride mt-8"
          videoid="0iYmeAZv7Nk"
          params="rel=0&playsinline=1"
        ></lite-youtube>
      </div>
    </div>
  </div>
</section>

<script>
  import 'lite-youtube-embed'
</script>