# Copiar a `.env` y completar. `.env` está en .gitignore (no se commitea).
# --- Supabase (reseñas en vivo) ---
# Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://<tu-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Tras crear la tabla y policies (supabase/schema.sql), ejecuta `pnpm build` para
# que los valores PUBLIC_* queden compilados en el sitio.